POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator

MASTER_BUILDER_API_PORT=4000
MASTER_BUILDER_ADMIN_UI_PORT=4100

ORCHESTRATOR_ADMIN_USERNAME=admin
ORCHESTRATOR_ADMIN_PASSWORD=replace-me
ORCHESTRATOR_PUBLIC_API_BASE_URL=http://localhost:4000
ORCHESTRATOR_ADMIN_UI_BASE_URL=http://localhost:4100
ORCHESTRATOR_CORS_ORIGINS=http://localhost:4100,http://127.0.0.1:4100
ORCHESTRATOR_CORS_ORIGIN_REGEX=

ORCHESTRATOR_DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@postgres:5432/orchestrator
POSTGRES_URL=postgresql+psycopg://orchestrator:orchestrator@postgres:5432/orchestrator
ORCHESTRATOR_REDIS_URL=redis://redis:6379/0

ORCHESTRATOR_GITHUB_INSTALL_STATE_SECRET=replace-me
ORCHESTRATOR_JIRA_OAUTH_STATE_SECRET=replace-me
ORCHESTRATOR_SECRET_CRYPTO_PROVIDER=vault_transit
# Vault Transit uses a stable key name here; key rotation happens inside Vault, not by changing this value.
ORCHESTRATOR_VAULT_ADDR=https://vault.example.com
ORCHESTRATOR_VAULT_TOKEN=replace-me
ORCHESTRATOR_VAULT_NAMESPACE=
ORCHESTRATOR_VAULT_TRANSIT_KEY=master-builder
ORCHESTRATOR_AWS_KMS_REGION=
ORCHESTRATOR_AWS_KMS_KEY_ID=
ORCHESTRATOR_GCP_KMS_KEY_NAME=
ORCHESTRATOR_SECRETS_ENCRYPTION_KEY=

ORCHESTRATOR_EMAIL_DELIVERY_PROVIDER=resend
ORCHESTRATOR_EMAIL_FROM_NAME=Master Builder
ORCHESTRATOR_EMAIL_FROM_ADDRESS=no-reply@example.com
ORCHESTRATOR_RESEND_API_KEY=replace-me

ORCHESTRATOR_VOICE_STT_PROVIDER=whisper
ORCHESTRATOR_VOICE_TTS_PROVIDER=pocket_tts
HF_HUB_OFFLINE=1

LLAMA_CPP_MODEL_URL=
LLAMA_CPP_MODEL_PATH=/models/gemma-4.gguf
LLAMA_CPP_PORT=8080
ENABLE_LLAMA_GPU=true
LLAMA_CPP_N_GPU_LAYERS=999
LLAMA_CPP_CTX_SIZE=8192

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:4100
NEXTAUTH_SECRET=replace-me
