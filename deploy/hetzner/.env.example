POSTGRES_PASSWORD=

MASTER_BUILDER_API_PORT=4000
MASTER_BUILDER_ADMIN_UI_PORT=4100

ORCHESTRATOR_ADMIN_USERNAME=admin
ORCHESTRATOR_ADMIN_PASSWORD=
ORCHESTRATOR_PUBLIC_API_BASE_URL=http://localhost:4000
ORCHESTRATOR_ADMIN_UI_BASE_URL=http://localhost:4100
ORCHESTRATOR_CORS_ORIGINS=http://localhost:4100,http://127.0.0.1:4100
ORCHESTRATOR_CORS_ORIGIN_REGEX=

ORCHESTRATOR_DATABASE_URL=
POSTGRES_URL=
ORCHESTRATOR_CLICKHOUSE_HTTP_URL=http://clickhouse:8123
ORCHESTRATOR_CLICKHOUSE_DATABASE=master_builder
ORCHESTRATOR_CLICKHOUSE_USERNAME=master_builder
ORCHESTRATOR_CLICKHOUSE_PASSWORD=

ORCHESTRATOR_GITHUB_INSTALL_STATE_SECRET=
ORCHESTRATOR_ATLASSIAN_OAUTH_STATE_SECRET=
ORCHESTRATOR_SECRETS_ENCRYPTION_KEY=

ORCHESTRATOR_EMAIL_DELIVERY_PROVIDER=resend
ORCHESTRATOR_EMAIL_FROM_NAME=Master Builder
ORCHESTRATOR_EMAIL_FROM_ADDRESS=no-reply@example.com
ORCHESTRATOR_RESEND_API_KEY=

ORCHESTRATOR_VOICE_STT_PROVIDER=whisper
ORCHESTRATOR_VOICE_TTS_PROVIDER=pocket_tts
HF_HUB_OFFLINE=1

# Required when a project enables QA demo recording. Use S3 or a MinIO-compatible endpoint.
ORCHESTRATOR_QA_DEMO_ARTIFACT_ENDPOINT=
ORCHESTRATOR_QA_DEMO_ARTIFACT_ACCESS_KEY=
ORCHESTRATOR_QA_DEMO_ARTIFACT_SECRET_KEY=
ORCHESTRATOR_QA_DEMO_ARTIFACT_BUCKET=
ORCHESTRATOR_QA_DEMO_ARTIFACT_PUBLIC_BASE_URL=
ORCHESTRATOR_QA_DEMO_ARTIFACT_SECURE=true
ORCHESTRATOR_QA_DEMO_RECORDER_PROCESS_TIMEOUT_SECONDS=900
ORCHESTRATOR_QA_DEMO_RELEASE_HEALTH_TIMEOUT_SECONDS=10
ORCHESTRATOR_QA_DEMO_ARTIFACT_URL_TIMEOUT_SECONDS=10
ORCHESTRATOR_QA_DEMO_IOS_RECORDER_COMMAND=
ORCHESTRATOR_QA_DEMO_IOS_CAPTURE_REFERENCE=
ORCHESTRATOR_QA_DEMO_ANDROID_RECORDER_COMMAND=
ORCHESTRATOR_QA_DEMO_ANDROID_CAPTURE_REFERENCE=
# Defaults to linux. Set to macos when Android emulators/devices are attached to a macOS worker.
ORCHESTRATOR_QA_DEMO_ANDROID_WORKER_PLATFORM=

LLAMA_CPP_MODEL_URL=
LLAMA_CPP_MODEL_PATH=/models/gemma-4.gguf
LLAMA_CPP_PORT=8080
ENABLE_LLAMA_GPU=true
LLAMA_CPP_N_GPU_LAYERS=999
LLAMA_CPP_CTX_SIZE=8192

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
AUTH_URL=http://localhost:4100
AUTH_SECRET=

# Required independent authentication keys; see docs/open-source-migration.md.
ORCHESTRATOR_ADMIN_TOKEN_SECRET=
ORCHESTRATOR_AUTH_TOKEN_SECRET=
ORCHESTRATOR_DISCORD_INSTALL_STATE_SECRET=
ORCHESTRATOR_JIRA_ACTION_TOKEN_SECRET=

# Exact reviewed runtime tool release; moving npm tags are rejected.
CODEX_NPM_VERSION=0.160.0

# Exact TLS ingress hostname plus internal API name; update for your deployment.
ORCHESTRATOR_TRUSTED_HOSTS=localhost,127.0.0.1,api
ORCHESTRATOR_PUBLIC_REGISTRATION_ENABLED=false
