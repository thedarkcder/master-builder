          <mxGeometry x="2520" y="260" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="loopBack" value="Refresh context + ask remaining questions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="2800" y="250" width="260" height="120" as="geometry"/>
