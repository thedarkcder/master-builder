# Required for Tailscale sidecar auth (replace with your key)
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_EXTRA_ARGS=--accept-dns=false
# Tailscale runs in the API container network namespace, so this is the API container port, not a host port.
TS_FUNNEL_PORT=4000

# Local service defaults
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator

ORCHESTRATOR_CLICKHOUSE_DATABASE=master_builder
ORCHESTRATOR_CLICKHOUSE_USERNAME=master_builder
ORCHESTRATOR_CLICKHOUSE_PASSWORD=master_builder

ORCHESTRATOR_ADMIN_USERNAME=admin
ORCHESTRATOR_ADMIN_PASSWORD=change-me
MASTER_BUILDER_API_PORT=60001
MASTER_BUILDER_ADMIN_UI_PORT=60002
MASTER_BUILDER_POSTGRES_PORT=60003
MASTER_BUILDER_MAILPIT_SMTP_PORT=60004
MASTER_BUILDER_MAILPIT_UI_PORT=60005
MASTER_BUILDER_CLICKHOUSE_HTTP_PORT=60006
MASTER_BUILDER_CLICKHOUSE_NATIVE_PORT=60007
MASTER_BUILDER_TEMPORAL_PORT=60008
MASTER_BUILDER_OTEL_GRPC_PORT=60009
MASTER_BUILDER_OTEL_HTTP_PORT=60010
MASTER_BUILDER_OTEL_METRICS_PORT=60011
MASTER_BUILDER_TEMPO_PORT=60012
MASTER_BUILDER_PROMETHEUS_PORT=60013
MASTER_BUILDER_GRAFANA_PORT=60014
ORCHESTRATOR_PUBLIC_API_BASE_URL=http://localhost:60001
ORCHESTRATOR_ADMIN_UI_BASE_URL=http://localhost:60002
ORCHESTRATOR_CORS_ORIGINS=http://localhost:60002,http://127.0.0.1:60002,https://master-builder.vercel.app
ORCHESTRATOR_CORS_ORIGIN_REGEX=^https://master-builder.*\\.vercel\\.app$
NEXT_PUBLIC_API_BASE_URL=http://localhost:60001

ORCHESTRATOR_GITHUB_INSTALL_STATE_SECRET=change-me
ORCHESTRATOR_JIRA_OAUTH_STATE_SECRET=change-me
# Email: use `smtp` (e.g. Mailpit) or `resend` (https://resend.com — verify your sending domain).
ORCHESTRATOR_EMAIL_DELIVERY_PROVIDER=smtp
ORCHESTRATOR_EMAIL_FROM_NAME="Master Builder"
ORCHESTRATOR_EMAIL_FROM_ADDRESS=no-reply@masterbuilder.local
# Optional reply path for transactional mail (supported by SMTP and Resend).
# ORCHESTRATOR_EMAIL_REPLY_TO=support@example.com
# Docker services use the internal Mailpit port. Host-based API runs should set localhost:60004.
ORCHESTRATOR_SMTP_HOST=mailpit
ORCHESTRATOR_SMTP_PORT=1025
# Resend (when ORCHESTRATOR_EMAIL_DELIVERY_PROVIDER=resend)
# ORCHESTRATOR_RESEND_API_KEY=re_xxxxxxxx
ORCHESTRATOR_CODEX_CLI_COMMAND=codex
ORCHESTRATOR_CODEX_STDERR_LOG_MODE=errors_only
ORCHESTRATOR_CODEX_PERSIST_TURN_COMPLETED_USAGE=true
ORCHESTRATOR_ORCHESTRATION_BACKEND=legacy
ORCHESTRATOR_TEMPORAL_TARGET_HOST=localhost:60008
ORCHESTRATOR_TEMPORAL_NAMESPACE=default
ORCHESTRATOR_TEMPORAL_TASK_QUEUE=master-builder
ORCHESTRATOR_WORKER_POLL_INTERVAL_SECONDS=5
ORCHESTRATOR_API_WORKERS=4
ORCHESTRATOR_DISCORD_GATEWAY_LOCK_KEY=947102033127
ORCHESTRATOR_DISCORD_GATEWAY_POLL_SECONDS=3
ORCHESTRATOR_VOICE_STT_PROVIDER=whisper
ORCHESTRATOR_VOICE_TTS_PROVIDER=pocket_tts

# Set a stable Fernet key for local secret encryption.
# Generate your own with:
# python3 - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY
ORCHESTRATOR_SECRETS_ENCRYPTION_KEY=REMOVED_PRIVATE_CREDENTIAL
