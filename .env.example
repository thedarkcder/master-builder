# Optional Tailscale sidecar: supply your own auth key only when enabled.
TS_AUTHKEY=
TS_EXTRA_ARGS=--accept-dns=false
# Tailscale runs in the API container network namespace, so this is the API container port, not a host port.
TS_FUNNEL_PORT=4000

# Local service defaults
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator_migrator
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=

ORCHESTRATOR_CLICKHOUSE_DATABASE=master_builder
ORCHESTRATOR_CLICKHOUSE_USERNAME=master_builder
ORCHESTRATOR_CLICKHOUSE_PASSWORD=

ORCHESTRATOR_ADMIN_USERNAME=admin
ORCHESTRATOR_ADMIN_PASSWORD=
MASTER_BUILDER_API_PORT=60001
MASTER_BUILDER_ADMIN_UI_PORT=60002
MASTER_BUILDER_POSTGRES_PORT=60003
MASTER_BUILDER_MAILPIT_SMTP_PORT=60004
MASTER_BUILDER_MAILPIT_UI_PORT=60005
MASTER_BUILDER_CLICKHOUSE_HTTP_PORT=60006
MASTER_BUILDER_CLICKHOUSE_NATIVE_PORT=60007
MASTER_BUILDER_TEMPORAL_PORT=60008
MASTER_BUILDER_OTEL_GRPC_PORT=60009
MASTER_BUILDER_OTEL_HTTP_PORT=60010
MASTER_BUILDER_OTEL_METRICS_PORT=60011
MASTER_BUILDER_TEMPO_PORT=60012
MASTER_BUILDER_PROMETHEUS_PORT=60013
MASTER_BUILDER_GRAFANA_PORT=60014
MASTER_BUILDER_S3_PORT=60015
ORCHESTRATOR_PUBLIC_API_BASE_URL=http://localhost:60001
ORCHESTRATOR_ADMIN_UI_BASE_URL=http://localhost:60002
ORCHESTRATOR_CORS_ORIGINS=http://localhost:60002,http://127.0.0.1:60002
ORCHESTRATOR_CORS_ORIGIN_REGEX=
NEXT_PUBLIC_API_BASE_URL=http://localhost:60001
SEAWEEDFS_ADMIN_ACCESS_KEY=masterbuilder-storage-admin
SEAWEEDFS_ADMIN_SECRET_KEY=
SEAWEEDFS_ADMIN_PASSWORD=
SEAWEEDFS_S3_CONFIG_PATH=.runtime-home/seaweedfs/s3.json
ORCHESTRATOR_QA_DEMO_ARTIFACT_ENDPOINT=127.0.0.1:60015
ORCHESTRATOR_QA_DEMO_ARTIFACT_ENDPOINT_INTERNAL=seaweedfs-s3:8333
ORCHESTRATOR_QA_DEMO_ARTIFACT_ACCESS_KEY=masterbuilder-qa
ORCHESTRATOR_QA_DEMO_ARTIFACT_SECRET_KEY=
ORCHESTRATOR_QA_DEMO_ARTIFACT_BUCKET=qa-demos
ORCHESTRATOR_QA_DEMO_ARTIFACT_PUBLIC_BASE_URL=http://localhost:60002/api/bff/api/qa-artifacts
ORCHESTRATOR_QA_DEMO_ARTIFACT_RETENTION_DAYS=30
ORCHESTRATOR_QA_DEMO_ARTIFACT_SECURE=false
ORCHESTRATOR_QA_DEMO_RECORDER_PROCESS_TIMEOUT_SECONDS=900
ORCHESTRATOR_QA_DEMO_RELEASE_HEALTH_TIMEOUT_SECONDS=10
ORCHESTRATOR_QA_DEMO_ARTIFACT_URL_TIMEOUT_SECONDS=10
ORCHESTRATOR_QA_DEMO_IOS_RECORDER_COMMAND=
ORCHESTRATOR_QA_DEMO_IOS_CAPTURE_REFERENCE=
ORCHESTRATOR_QA_DEMO_ANDROID_RECORDER_COMMAND=
ORCHESTRATOR_QA_DEMO_ANDROID_CAPTURE_REFERENCE=
# Hybrid local proof runs default Android to macOS so browser, iOS, and Android can be recorded by the same local worker.
ORCHESTRATOR_QA_DEMO_ANDROID_WORKER_PLATFORM=macos

ORCHESTRATOR_GITHUB_INSTALL_STATE_SECRET=
ORCHESTRATOR_ATLASSIAN_OAUTH_STATE_SECRET=
# Email: use `smtp` (e.g. Mailpit) or `resend` (https://resend.com — verify your sending domain).
ORCHESTRATOR_EMAIL_DELIVERY_PROVIDER=smtp
ORCHESTRATOR_EMAIL_FROM_NAME="Master Builder"
ORCHESTRATOR_EMAIL_FROM_ADDRESS=no-reply@masterbuilder.local
# Optional reply path for transactional mail (supported by SMTP and Resend).
# ORCHESTRATOR_EMAIL_REPLY_TO=support@example.com
# Docker services use the internal Mailpit port. Host-based API runs should set localhost:60004.
ORCHESTRATOR_SMTP_HOST=mailpit
ORCHESTRATOR_SMTP_PORT=1025
# Resend (when ORCHESTRATOR_EMAIL_DELIVERY_PROVIDER=resend)
# ORCHESTRATOR_RESEND_API_KEY=<YOUR_RESEND_API_KEY>
ORCHESTRATOR_CODEX_CLI_COMMAND=codex
ORCHESTRATOR_CODEX_STDERR_LOG_MODE=errors_only
ORCHESTRATOR_CODEX_PERSIST_TURN_COMPLETED_USAGE=true
ORCHESTRATOR_ORCHESTRATION_BACKEND=legacy
ORCHESTRATOR_TEMPORAL_TARGET_HOST=localhost:60008
ORCHESTRATOR_TEMPORAL_NAMESPACE=default
ORCHESTRATOR_TEMPORAL_TASK_QUEUE=master-builder
ORCHESTRATOR_WORKER_POLL_INTERVAL_SECONDS=5
ORCHESTRATOR_API_WORKERS=4
ORCHESTRATOR_DISCORD_GATEWAY_LOCK_KEY=947102033127
ORCHESTRATOR_DISCORD_GATEWAY_POLL_SECONDS=3
ORCHESTRATOR_VOICE_STT_PROVIDER=whisper
ORCHESTRATOR_VOICE_TTS_PROVIDER=pocket_tts

# Set a stable Fernet key for local secret encryption.
# Generate your own with:
# python3 - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY
ORCHESTRATOR_SECRETS_ENCRYPTION_KEY=

# Required keys/passwords are intentionally blank. Run scripts/init_local_env.py.
ORCHESTRATOR_ADMIN_TOKEN_SECRET=
ORCHESTRATOR_AUTH_TOKEN_SECRET=
ORCHESTRATOR_DISCORD_INSTALL_STATE_SECRET=
ORCHESTRATOR_JIRA_ACTION_TOKEN_SECRET=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS_ENABLED=false
AUTH_SECRET=
ORCHESTRATOR_DATABASE_URL=
ORCHESTRATOR_CONTAINER_DATABASE_URL=
ORCHESTRATOR_CODEX_SANDBOX_MODE=workspace-write

# Exact reviewed runtime tool release; moving npm tags are rejected.
CODEX_NPM_VERSION=0.160.0

# Migration credentials are used only by the explicit owner migration job.
ORCHESTRATOR_MIGRATION_DATABASE_URL=
ORCHESTRATOR_CONTAINER_MIGRATION_DATABASE_URL=
ORCHESTRATOR_AUTO_MIGRATE_ON_STARTUP=false
# Explicit local-only account creation opt-in. Disable on public deployments.
ORCHESTRATOR_PUBLIC_REGISTRATION_ENABLED=true
ORCHESTRATOR_AUTH_REGISTRATION_GLOBAL_LIMIT=20
ORCHESTRATOR_AUTH_REGISTRATION_PEER_LIMIT=5
ORCHESTRATOR_AUTH_LOGIN_ACCOUNT_LIMIT=10
ORCHESTRATOR_AUTH_LOGIN_PEER_LIMIT=60
ORCHESTRATOR_AUTH_RESET_ACCOUNT_LIMIT=3
ORCHESTRATOR_AUTH_RESET_PEER_LIMIT=30

# Exact allowed Host names; add your TLS ingress hostname for a public deployment.
ORCHESTRATOR_TRUSTED_HOSTS=localhost,127.0.0.1,api
