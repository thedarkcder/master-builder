# Required for Tailscale sidecar auth (replace with your key)
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_EXTRA_ARGS=--accept-dns=false
TS_FUNNEL_PORT=4000

# Local service defaults
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator

ORCHESTRATOR_ADMIN_USERNAME=admin
ORCHESTRATOR_ADMIN_PASSWORD=change-me
ORCHESTRATOR_PUBLIC_API_BASE_URL=http://localhost:4000
ORCHESTRATOR_ADMIN_UI_BASE_URL=http://localhost:4100
ORCHESTRATOR_CORS_ORIGINS=http://localhost:4100,http://127.0.0.1:4100
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

ORCHESTRATOR_GITHUB_INSTALL_STATE_SECRET=change-me
ORCHESTRATOR_JIRA_OAUTH_STATE_SECRET=change-me
ORCHESTRATOR_CODEX_CLI_COMMAND=codex
ORCHESTRATOR_CODEX_MODEL=gpt-5-codex
ORCHESTRATOR_CODEX_STDERR_LOG_MODE=errors_only
ORCHESTRATOR_WORKER_POLL_INTERVAL_SECONDS=5
ORCHESTRATOR_API_WORKERS=4
ORCHESTRATOR_DISCORD_GATEWAY_LOCK_KEY=947102033127
ORCHESTRATOR_DISCORD_GATEWAY_POLL_SECONDS=3

# Set a stable Fernet key for local secret encryption.
# Generate your own with:
# python3 - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY
ORCHESTRATOR_SECRETS_ENCRYPTION_KEY=bi0OHXuAUvn3fYTcp6-ZRhos0aQoPMXwa0QtReUV_ms=
