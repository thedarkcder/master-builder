{
  "name": "master-builder-admin-ui",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --webpack -p ${ADMIN_UI_PORT:-60002}",
    "dev:turbo": "next dev --turbopack -p ${ADMIN_UI_PORT:-60002}",
    "lint": "next typegen && tsc --noEmit -p tsconfig.lint.json",
    "build": "next build",
    "start": "next start -p ${ADMIN_UI_PORT:-60002}",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live": "PLAYWRIGHT_RUN_LIVE=1 playwright test --project=chromium-live"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "5.9.3"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
