# Host-based UI quick start. Public configuration, not a credential.
NEXT_PUBLIC_API_BASE_URL=http://localhost:60001
# Runtime server requests; Compose overrides this with http://api:4000.
ORCHESTRATOR_API_BASE_URL=http://localhost:60001
AUTH_URL=http://localhost:60002
# Generate your own independent random value with at least 32 characters.
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=
# Enable only behind a trusted listener/reverse proxy with validated Host headers.
AUTH_TRUST_HOST=true
ADMIN_UI_PORT=60002
